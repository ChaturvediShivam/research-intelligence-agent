# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---- Required for any LLM call -------------------------------------------
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Runtime --------------------------------------------------------------
ENVIRONMENT=local            # local | test | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false               # true in production for parseable logs

# ---- Models (see docs/decisions/ADR-007-model-routing.md) -----------------
PLANNING_MODEL=claude-opus-5-5
SYNTHESIS_MODEL=claude-opus-5-5
EXTRACTION_MODEL=claude-haiku-4-5

# ---- Storage --------------------------------------------------------------
DATABASE_PATH=data/runs.db
VECTOR_BACKEND=sqlite        # sqlite locally and in evals; postgres when deployed
# POSTGRES_DSN=postgresql://user:password@host:5432/dbname

# ---- Retrieval ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=12

# ---- Guardrails -----------------------------------------------------------
MAX_COST_USD_PER_RUN=2.0
MAX_SOURCES_PER_RUN=12
FETCH_TIMEOUT_SECONDS=20
# Comma-separated. Empty allows any public host; SSRF protection always applies.
ALLOWED_SOURCE_DOMAINS=
BLOCKED_SOURCE_DOMAINS=
