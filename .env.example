# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---- Required for any LLM call -------------------------------------------
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Runtime --------------------------------------------------------------
ENVIRONMENT=local            # local | test | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false               # true in production for parseable logs

# ---- Models (see docs/decisions/ADR-007-model-routing.md) -----------------
PLANNING_MODEL=claude-opus-5-5
SYNTHESIS_MODEL=claude-opus-5-5
EXTRACTION_MODEL=claude-haiku-4-5

# ---- Storage --------------------------------------------------------------
DATABASE_PATH=data/runs.db
VECTOR_BACKEND=sqlite        # sqlite locally and in evals; postgres when deployed
# POSTGRES_DSN=postgresql://user:password@host:5432/dbname

# ---- Retrieval ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=12
# Chunks per ONNX forward pass. A MEMORY bound, not a throughput knob:
# attention costs batch x sequence^2, and stage 4 embeds every chunk of every
# source in one call. fastembed's own default of 256 OOM-killed a 512 MB
# container on every real run (F-019). 4 peaks at ~350 MB regardless of chunk
# count. Raise it only alongside the instance size.
EMBEDDING_BATCH_SIZE=4
# Where the embedding model is cached. Unset, fastembed uses the system temp
# directory and re-downloads the model on every cold start. In the container
# this should point at the persistent disk.
FASTEMBED_CACHE_PATH=

# ---- Guardrails -----------------------------------------------------------
MAX_COST_USD_PER_RUN=2.0
MAX_SOURCES_PER_RUN=12
FETCH_TIMEOUT_SECONDS=20
# Comma-separated. Empty allows any public host; SSRF protection always applies.
ALLOWED_SOURCE_DOMAINS=
BLOCKED_SOURCE_DOMAINS=

# ---- SEC EDGAR ------------------------------------------------------------
# sec.gov returns 403 to automated clients that do not declare a contact
# address (https://www.sec.gov/os/webmaster-faq). Sent only to sec.gov hosts.
# Leave unset and SEC filings stay unreadable; nothing else is affected.
SEC_CONTACT_EMAIL=you@example.com
